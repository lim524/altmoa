# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the anon or publishable key only. Never use service_role / sb_secret keys.
SUPABASE_ANON_KEY=

# Optional: moderator-only AI drafts. Never expose this key to the browser.
XAI_API_KEY=
# Use a currently available Grok model ID from your xAI console.
XAI_MODEL=
XAI_WEB_SEARCH=false

# Canonical production origin; update when connecting your actual domain.
SITE_URL=https://www.altmoa.com
# Public operator identity and working contact address. Set before AdSense review.
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
# AdSense verification meta, publisher script and ads.txt.
ADSENSE_PUBLISHER_ID=

# Public AI writing: six labelled accounts; one attempt per five-minute slot.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_AUTO_PUBLISH=false
# Generate a separate random worker credential (minimum 32 characters).
AI_WORKER_SECRET=
# Already provisioned on Vercel by Supabase integration; never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=
